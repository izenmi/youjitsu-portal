---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import points from '../data/points.json';
import students from '../data/students.json';

const base = import.meta.env.BASE_URL;
const pickup = ['ayanokoji', 'horikita', 'ichinose', 'ryuen', 'sakayanagi', 'karuizawa']
  .map((id) => students.students.find((s) => s.id === id)!)
  .filter(Boolean);

const sections = [
  { href: `${base}students/`, icon: '🎓', title: '生徒名鑑', desc: 'OAA風レーダーチャート付きの全キャラデータベース' },
  { href: `${base}exams/`, icon: '📋', title: '特別試験アーカイブ', desc: '歴代特別試験のルールと結果を年表で辿る' },
  { href: `${base}points/`, icon: '📈', title: 'クラスポイント推移', desc: '4クラスの攻防をグラフで可視化' },
  { href: `${base}quiz/`, icon: '✏️', title: '原作知識クイズ', desc: '難易度3段階×10問であなたの読み込み度を測定' },
  { href: `${base}shindan/`, icon: '🧭', title: 'クラス適性診断', desc: 'あなたが入学したらどのクラス?' },
];
---

<Base>
  <section class="hero card">
    <p class="hero-tag">WELCOME TO THE CLASSROOM OF THE SUPREME MERITOCRACY</p>
    <h1>高度育成高等学校<br />学内ポータル</h1>
    <p class="hero-lead">
      進学率・就職率100%。しかしその実態は、クラスと個人が「実力」で選別される超実力至上主義の教育機関——。
      ここは『ようこそ実力至上主義の教室へ』の世界を、生徒名鑑・特別試験の記録・クラスポイントの攻防から辿る非公式ファンサイトです。
    </p>
    <p class="hero-note">
      📖 右上のボタンで<strong>読了位置</strong>を設定すると、それより先のネタバレは自動で隠されます。未読の方も安心してご利用ください。
    </p>
  </section>

  <section>
    <h2 class="section-title">メニュー</h2>
    <div class="grid menu-grid">
      {sections.map((s) => (
        <a href={s.href} class="card menu-card">
          <span class="menu-icon">{s.icon}</span>
          <strong>{s.title}</strong>
          <p class="muted">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-title">注目の生徒</h2>
    <div class="pickup-row">
      {pickup.map((s) => (
        <a href={`${base}students/${s.id}/`} class="pickup-card card">
          <Portrait id={s.portrait ? s.id : `sil-${s.id}`} size={84} classKey={s.class} />
          <strong>{s.name}</strong>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-title">クラスポイント現況</h2>
    <div id="standings" class="grid standings-grid"></div>
    <p class="muted" style="font-size: 0.82rem;">読了位置時点での順位を表示しています。<a href={`${base}points/`}>推移グラフを見る →</a></p>
  </section>

  <script is:inline define:vars={{ data: points }}>
    const box = document.getElementById('standings');
    const CLASS_KEYS = { sakayanagi: 'A', ichinose: 'B', ryuen: 'C', horikita: 'D' };
    const render = () => {
      const progress = window.ANHS ? window.ANHS.progress : 0;
      const visible = data.points.filter((p) => p.ord <= progress);
      const snap = visible[visible.length - 1] ?? data.points[0];
      const rows = data.series
        .map((s) => ({ label: s.label, key: s.key, cp: snap[s.key] }))
        .sort((a, b) => b.cp - a.cp);
      box.innerHTML = rows
        .map(
          (r, i) => `<div class="card standing-card">
            <span class="standing-pos">${i + 1}位</span>
            <span class="class-chip" data-class="${CLASS_KEYS[r.key]}">${r.label}</span>
            <b class="standing-cp">${r.cp}<small>cp</small></b>
            <span class="standing-when muted">${snap.label}時点</span>
          </div>`
        )
        .join('');
    };
    document.addEventListener('anhs:progress', render);
    window.addEventListener('DOMContentLoaded', render);
  </script>

  <style>
    .hero { padding: 30px 26px; border-top: 4px solid var(--accent); }
    .hero-tag { font-size: 0.66rem; letter-spacing: 0.14em; color: var(--ink-2); margin: 0; }
    .hero h1 { font-size: 1.9rem; line-height: 1.3; margin: 8px 0 12px; }
    .hero-lead { max-width: 46em; }
    .hero-note {
      background: var(--surface-2); border-radius: 10px; padding: 10px 14px;
      font-size: 0.88rem; margin-bottom: 0;
    }
    .menu-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    .menu-card { padding: 16px; text-decoration: none; }
    .menu-card:hover { border-color: var(--accent); }
    .menu-icon { font-size: 1.5rem; }
    .menu-card strong { display: block; margin: 6px 0 2px; }
    .menu-card p { font-size: 0.8rem; margin: 0; }
    .pickup-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .pickup-card {
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      padding: 14px 18px; text-decoration: none; font-size: 0.88rem;
    }
    .pickup-card:hover { border-color: var(--accent); }
    .standings-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
  </style>

  <style is:global>
    .standing-card {
      padding: 12px 14px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    }
    .standing-pos { font-weight: 800; color: var(--accent); }
    .standing-cp { margin-left: auto; font-size: 1.1rem; }
    .standing-cp small { font-size: 0.7rem; color: var(--ink-2); margin-left: 2px; }
    .standing-when { flex-basis: 100%; font-size: 0.72rem; }
  </style>
</Base>
