---
import Base from '../../layouts/Base.astro';
import exams from '../../data/exams.json';

const base = import.meta.env.BASE_URL;
const arcs = ['1年生編', '2年生編', '3年生編'];
---

<Base title="特別試験アーカイブ" description="歴代特別試験のルール・結果・退学者を年表形式で整理。ネタバレは読了位置に応じて自動で隠されます。">
  <h1>📋 特別試験アーカイブ</h1>
  <p class="muted">高度育成高等学校で行われた特別試験・主要イベントの記録。読了位置(右上📖)より先の試験は内容を伏せています。</p>

  {arcs.map((arc) => (
    <section>
      <h2 class="section-title">{arc}</h2>
      <div class="timeline" data-sp-count>
        <p class="sp-note"></p>
        {exams.filter((e) => e.arc === arc).map((e) => (
          <div class="timeline-item" data-sp={e.sp > 1 ? e.sp : undefined}>
            <div class="timeline-marker">
              <span class="vol-badge">{e.vol}巻</span>
            </div>
            <a href={`${base}exams/${e.id}/`} class="card exam-card">
              <div class="exam-head">
                <strong>{e.name}</strong>
                <span class="type-tag">{e.type}</span>
              </div>
              <p class="muted exam-season">{e.season}</p>
              <p class="exam-rule">{e.rule.length > 90 ? e.rule.slice(0, 90) + '…' : e.rule}</p>
            </a>
          </div>
        ))}
      </div>
    </section>
  ))}

  <style>
    .timeline { position: relative; padding-left: 4px; }
    .timeline-item {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 12px;
      margin-bottom: 14px;
    }
    .timeline-marker { position: relative; text-align: center; padding-top: 12px; }
    .timeline-marker::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0;
      bottom: -14px;
      width: 2px;
      background: var(--line);
      z-index: 0;
    }
    .timeline-item:last-child .timeline-marker::before { bottom: auto; height: 100%; }
    .vol-badge {
      position: relative; z-index: 1;
      display: inline-block;
      background: var(--navy); color: var(--navy-ink);
      font-size: 0.72rem; font-weight: 700;
      border-radius: 999px; padding: 3px 8px;
    }
    .exam-card { display: block; padding: 14px 16px; text-decoration: none; }
    .exam-card:hover { border-color: var(--accent); }
    .exam-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .exam-head strong { font-size: 1.02rem; }
    .type-tag {
      font-size: 0.72rem; font-weight: 700;
      background: var(--accent-soft); color: var(--accent);
      border-radius: 6px; padding: 2px 8px;
    }
    .exam-season { font-size: 0.8rem; margin: 4px 0; }
    .exam-rule { font-size: 0.88rem; margin: 0; color: var(--ink-2); }
  </style>
</Base>
