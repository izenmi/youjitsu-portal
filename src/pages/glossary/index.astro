---
import Base from '../../layouts/Base.astro';
import glossary from '../../data/glossary.json';
import timeline from '../../data/timeline.json';

const spLabel = (sp: number) => timeline.volumes.find((v) => v.ord === sp)?.label ?? '';
---

<Base title="用語集・学校システム図解" description="クラスポイント・プライベートポイント・OAAなど、よう実の複雑な学校システムを図解付きで解説。">
  <h1>📖 用語集・学校システム図解</h1>
  <p class="muted">
    高度育成高等学校の複雑なルールを図解付きでまとめました。ネタバレを含む用語は読了位置に応じて隠されます。
  </p>

  <nav class="card gl-toc">
    {glossary.map((c) => <a href={`#${c.category}`}>{c.category}</a>)}
  </nav>

  {glossary.map((c) => (
    <section id={c.category}>
      <h2 class="section-title">{c.category}</h2>

      {c.diagram === 'points' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 210" role="img" aria-label="ポイントの流れ図">
            <rect x="20" y="70" width="170" height="70" rx="10" fill="var(--accent)" opacity="0.9" />
            <text x="105" y="100" text-anchor="middle" font-size="15" font-weight="800" fill="#fff">クラスポイント</text>
            <text x="105" y="122" text-anchor="middle" font-size="11" fill="#fff">クラスの格を決める</text>
            <rect x="440" y="70" width="180" height="70" rx="10" fill="var(--navy)" />
            <text x="530" y="100" text-anchor="middle" font-size="15" font-weight="800" fill="var(--navy-ink)">プライベートポイント</text>
            <text x="530" y="122" text-anchor="middle" font-size="11" fill="var(--navy-ink)">1pt = 1円で使える</text>
            <line x1="190" y1="105" x2="432" y2="105" stroke="var(--ink-2)" stroke-width="2.5" marker-end="url(#gl-arrow)" />
            <text x="310" y="92" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--ink)">毎月 CP×100 を支給</text>
            <rect x="230" y="10" width="170" height="40" rx="8" fill="var(--surface-2)" stroke="var(--line)" />
            <text x="315" y="35" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--ink)">特別試験・生活態度</text>
            <line x1="270" y1="50" x2="150" y2="66" stroke="var(--ink-2)" stroke-width="2" marker-end="url(#gl-arrow)" />
            <text x="160" y="52" text-anchor="middle" font-size="11" fill="var(--ink-2)">増減</text>
            <rect x="230" y="150" width="170" height="40" rx="8" fill="var(--surface-2)" stroke="var(--line)" />
            <text x="315" y="175" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--ink)">生徒間の取引・買収</text>
            <line x1="440" y1="145" x2="380" y2="158" stroke="var(--ink-2)" stroke-width="2" marker-end="url(#gl-arrow)" />
            <defs>
              <marker id="gl-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                <path d="M0,0 L8,4 L0,8 Z" fill="var(--ink-2)" />
              </marker>
            </defs>
          </svg>
        </div>
      )}

      {c.diagram === 'ladder' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 230" role="img" aria-label="クラス昇降格の図">
            {['D', 'C', 'B', 'A'].map((cls, i) => (
              <>
                <rect x={40 + i * 165} y={150 - i * 40} width="130" height={60 + i * 40} rx="8"
                  fill={`var(--class-${cls.toLowerCase()})`} opacity="0.85" />
                <text x={105 + i * 165} y={185 - i * 40} text-anchor="middle" font-size="26" font-weight="800" fill="#fff">{cls}</text>
              </>
            ))}
            <text x="105" y="140" text-anchor="middle" font-size="11.5" fill="var(--ink-2)">落ちこぼれ?</text>
            <text x="600" y="100" text-anchor="middle" font-size="11.5" fill="var(--ink-2)">卒業時の進路保証</text>
            <path d="M 130 105 Q 350 20 580 68" fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="7 5" marker-end="url(#gl-arrow2)" />
            <text x="350" y="38" text-anchor="middle" font-size="13" font-weight="800" fill="var(--accent)">CPで上位を逆転すれば昇格できる</text>
            <defs>
              <marker id="gl-arrow2" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                <path d="M0,0 L8,4 L0,8 Z" fill="var(--accent)" />
              </marker>
            </defs>
          </svg>
        </div>
      )}

      {c.diagram === 'expel' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 200" role="img" aria-label="退学までの分岐フロー">
            <rect x="20" y="75" width="150" height="50" rx="8" fill="var(--accent)" opacity="0.9" />
            <text x="95" y="105" text-anchor="middle" font-size="13.5" font-weight="800" fill="#fff">赤点・ペナルティ</text>
            <rect x="270" y="75" width="160" height="50" rx="8" fill="var(--surface-2)" stroke="var(--line)" />
            <text x="350" y="98" text-anchor="middle" font-size="12.5" font-weight="700" fill="var(--ink)">救済手段はある?</text>
            <text x="350" y="115" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">プロテクトP / 2000万PP</text>
            <line x1="170" y1="100" x2="262" y2="100" stroke="var(--ink-2)" stroke-width="2.5" marker-end="url(#gl-arrow3)" />
            <rect x="520" y="20" width="150" height="50" rx="8" fill="#2e8b57" />
            <text x="595" y="50" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">処分の無効化</text>
            <rect x="520" y="130" width="150" height="50" rx="8" fill="var(--navy)" />
            <text x="595" y="160" text-anchor="middle" font-size="14" font-weight="800" fill="var(--navy-ink)">退学</text>
            <line x1="430" y1="88" x2="512" y2="52" stroke="#2e8b57" stroke-width="2.5" marker-end="url(#gl-arrow3)" />
            <text x="470" y="55" text-anchor="middle" font-size="11.5" font-weight="700" fill="#2e8b57">あり(超希少)</text>
            <line x1="430" y1="112" x2="512" y2="148" stroke="var(--ink-2)" stroke-width="2.5" marker-end="url(#gl-arrow3)" />
            <text x="470" y="150" text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--ink-2)">なし</text>
            <defs>
              <marker id="gl-arrow3" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                <path d="M0,0 L8,4 L0,8 Z" fill="var(--ink-2)" />
              </marker>
            </defs>
          </svg>
        </div>
      )}

      <div class="gl-terms" data-sp-count>
        <p class="sp-note"></p>
        {c.terms.map((t) => (
          <div class="card gl-term" data-sp={t.sp > 1 ? t.sp : undefined} data-sp-label={spLabel(t.sp)}>
            <h3>{t.term} <small class="muted">{t.kana}</small></h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <style>
    .gl-toc {
      display: flex; flex-wrap: wrap; gap: 4px 16px;
      padding: 10px 16px; margin-top: 12px; font-size: 0.88rem;
    }
    .gl-toc a { text-decoration: none; font-weight: 700; }
    .gl-toc a:hover { color: var(--accent); }
    .gl-diagram { padding: 14px; margin-bottom: 12px; }
    .gl-diagram svg { width: 100%; height: auto; display: block; }
    .gl-terms { display: grid; gap: 10px; }
    .gl-term { padding: 12px 18px; }
    .gl-term h3 { margin: 0 0 6px; font-size: 1rem; }
    .gl-term p { margin: 0; font-size: 0.9rem; }
  </style>
</Base>
